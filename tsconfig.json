{
  // Base config: the v3 library source, as the rollup build and the IDE see
  // it. `pnpm compile` runs it directly; tsconfig.test.json / tsconfig.v2.json
  // extend it for the jest suites (overriding module/resolution for jest's
  // CommonJS world), and tsconfig.bench.json for the benchmarks. tsx runs
  // codegen/ and the playground from source. tsconfig.globals.json checks
  // the same source against the sanctioned runtime globals only. Targets per
  // docs-dev/v3-specs/v3-packaging.md: ES2022, Node >= 22.12.
  "compilerOptions": {
    /* Language and environment */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // lib defaults to the ES2022 set; @types/node supplies AbortSignal etc.
    "types": ["node"],

    /* Emit — consumed by the rollup pipeline (dts bundling reads build/dts) */
    "declaration": true,
    "declarationDir": "build/dts",
    "outDir": "build",
    "rootDir": "src",
    "removeComments": true,

    /* Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Interop */
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // v3 library source only. /v2-src (the frozen v2 engine) and test/ are excluded
  // from this build config; the test runners use tsconfig.test.json / tsconfig.v2.json.
  // src/dev/playground.ts is gitignored scratch — whatever state it is in must
  // never break `pnpm compile` or the build.
  "include": ["src"],
  "exclude": ["node_modules", "build", "v2-src", "test", "src/dev/playground.ts"]
}
