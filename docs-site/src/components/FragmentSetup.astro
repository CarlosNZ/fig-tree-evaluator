---
/**
 * Some of the Fragments page's fragments, from their sources in
 * lib/fragments.ts, the same ones the page's examples evaluate with, so what
 * the page shows is what ran. By default it's host code registering them: a
 * `ts` block, type-checked when the site is built like any other. With
 * `plain`, each definition is shown on its own, as a `json5` block titled
 * with the fragment's name, for the parts of the page about writing one.
 */
import { Code } from '@astrojs/starlight/components'
import { fragmentSources } from '../lib/fragments'

interface Props {
  /** The fragments to show, in order. */
  names: string[]
  /** A label for the code block. Ignored with `plain`. */
  title?: string
  /** Register the HTTP operators too, for fragments that send requests. */
  http?: boolean
  /** Show each definition on its own, as JSON5, without the host code. */
  plain?: boolean
}

const { names, title = 'fragments.ts', http = false, plain = false } = Astro.props

const sources = names.map((name) => {
  const source = fragmentSources[name]
  if (source === undefined)
    throw new Error(`<FragmentSetup>: no fragment '${name}' in lib/fragments.ts`)
  return { name, source }
})

const indent = (text: string, by: string) => text.replace(/\n/g, `\n${by}`)
const definitions = sources.map(({ name, source }) => `    ${name}: ${indent(source, '    ')},`)

const setup = http
  ? `import { FigTree, FetchClient, coreOperators, httpOperators } from 'fig-tree-evaluator'

const fig = new FigTree({
  operators: [coreOperators, httpOperators(new FetchClient())],`
  : `import { FigTree } from 'fig-tree-evaluator'

const fig = new FigTree({`

const code = `${setup}
  fragments: {
${definitions.join('\n')}
  },
})`
---

{
  plain ? (
    sources.map(({ name, source }) => <Code code={source} lang="json5" title={name} />)
  ) : (
    <Code code={code} lang="ts" title={title} />
  )
}
