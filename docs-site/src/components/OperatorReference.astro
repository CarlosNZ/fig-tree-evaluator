---
/**
 * Operator reference entries, rendered at build time from the instance's
 * catalog (`getCatalog`): the registry's own snapshot, so every name, alias,
 * type and null behaviour shown is the one the code has, joined with the
 * package's listings for descriptions, labels and colours, as the editor
 * shows them. The docs' own operator notes, where an operator has one, add to
 * or replace a description, and add longer notes below it
 * (src/lib/operatorNotes.ts).
 *
 * Three forms. `index` is the operators page's index: every operator's name,
 * by category, each linking to its entry. `all` is the page's entries, which
 * the page places after its own sections: every operator, under a heading
 * per category that stays pinned while its operators scroll beneath it.
 * Under the heading, and not pinned with it, are a row of links to the
 * category's operators and the category's own note, where it has one.
 * `names` is a short list of chosen operators for any other page, which can
 * show each one's category as a pill.
 */
import { render } from 'astro:content'
import { figTree } from '../lib/figTree'
import { catalog, categoryId, operatorGroups, type CatalogOperator } from '../lib/operatorCatalog'
import { loadCategoryNotes, loadOperatorNotes } from '../lib/operatorNotes'
import Expression from './Expression.astro'
import OperatorEntry from './OperatorEntry.astro'

type Props =
  | {
      /** Every operator's name, by category: the operators page's index. */
      index: true
    }
  | {
      /** Every operator, by category: the operators page's entries. */
      all: true
    }
  | {
      /** Canonical operator names, in the order to show them. */
      names: string[]
      /** Show each operator's category, for a list that mixes them. */
      showCategory?: boolean
    }

const notes = await loadOperatorNotes(catalog)
const categoryNotes = await loadCategoryNotes(catalog)

/** What an entry needs beside the operator: its category, note and notes body. */
const withNotes = async (op: CatalogOperator) => {
  const note = notes.get(op.name)
  return {
    op,
    category: catalog.categories.find((c) => c.name === op.category)!,
    note: note?.data,
    Notes: note?.body?.trim() ? (await render(note)).Content : null,
  }
}

const groups =
  'all' in Astro.props
    ? await Promise.all(
        operatorGroups().map(async ({ category, operators }) => {
          const note = categoryNotes.get(category.name)
          return {
            category,
            Notes: note?.body?.trim() ? (await render(note)).Content : null,
            entries: await Promise.all(operators.map(withNotes)),
          }
        })
      )
    : null

const list =
  'names' in Astro.props
    ? await Promise.all(
        Astro.props.names.map((name) => {
          const op = catalog.operators.find((op) => op.name === name)
          if (!op) throw new Error(`<OperatorReference>: '${name}' is not a registered operator`)
          return withNotes(op)
        })
      )
    : null
const showCategory = 'names' in Astro.props && Astro.props.showCategory === true

const index = 'index' in Astro.props ? operatorGroups() : null
---

<div class="fds-reference not-content">
  {
    index && (
      <nav class="fds-ref-index" aria-label="Operators by category">
        {index.map(({ category, operators }) => (
          <div class="fds-ref-index-group" style={`--fds-category:${category.colors.background}`}>
            <a class="fds-ref-index-category" href={`#${categoryId(category.name)}`}>
              {category.displayName}
            </a>
            <ul>
              {operators.map((op) => (
                <li>
                  <a href={`#op-${op.name}`}>
                    <code>{op.name}</code>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    )
  }
  {
    groups?.map(({ category, Notes, entries }) => (
      <section class="fds-ref-category" style={`--fds-category:${category.colors.background}`}>
        {/* The id is the heading's, which the page's contents list tracks */}
        <h2 class="fds-ref-category-header" id={categoryId(category.name)}>
          {category.displayName}
        </h2>
        {entries.length > 1 && (
          <nav class="fds-ref-category-index" aria-label={`${category.displayName} operators`}>
            <ul>
              {entries.map(({ op }) => (
                <li>
                  <a href={`#op-${op.name}`}>
                    <code>{op.name}</code>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {Notes && (
          <div class="fds-ref-category-notes">
            <Notes components={{ Expression }} />
          </div>
        )}
        {entries.map((entry) => (
          <OperatorEntry {...entry} />
        ))}
      </section>
    ))
  }
  {list?.map((entry) => <OperatorEntry {...entry} showCategory={showCategory} />)}
  {
    !index && (
      <p class="fds-reference-note">
        Generated from fig-tree-evaluator {figTree.version}'s operator definitions.
      </p>
    )
  }
</div>
