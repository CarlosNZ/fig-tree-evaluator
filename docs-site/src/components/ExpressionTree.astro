---
/**
 * An expression drawn as a tree: each node with its operator and the result
 * it gives, its parameters below it, labelled with their names where the
 * expression names them. Every result is computed when the site is built, by
 * evaluating that node's subtree with the example's data, so the diagram
 * can't disagree with the library.
 *
 * Draws shorthand nodes and their parameters; anything else is a leaf, shown
 * as its value, and a reference also shows the value it reads. Each subtree
 * is evaluated on its own, so an expression whose nodes read `$vars` or
 * `$element` from a node above them can't be drawn, and a branch a lazy
 * operator such as `if` doesn't take still shows a result.
 *
 * The layout happens in the browser (src/lib/treeLayout.ts), which packs the
 * branches and draws the connectors; without it, CSS draws a plainer
 * diagram from the same lists.
 *
 * An example with data shows it in the diagram, so the values its references
 * read come from somewhere. The layout puts it in the first corner the tree
 * leaves empty, or else at the figure's bottom-left, beside the tree;
 * `dataPosition` places it instead, as CSS offsets from the figure's edges.
 * It scrolls with the diagram, so it keeps its place on a narrow screen.
 *
 * "Open in editor" opens the expression in a full-size editor over the page
 * (ExpressionEditor.tsx), with `caption` at its foot if given, so a page
 * needs no separate widget for the same example.
 */
import JSON5 from 'json5'
import { figTree } from '../lib/figTree'
import { dedent } from '../lib/dedent'
import { toJson5 } from '../lib/json5'
import { playgroundHref } from '../lib/playgroundLink'
import ExpressionEditor from './playground/ExpressionEditor.tsx'
import TreeItem, { type Item } from './TreeItem.astro'

interface Props {
  /** The expression, as JSON5 source. */
  code: string
  /** The evaluation data, as JSON5 source. */
  data?: string
  /** What the diagram shows, for screen readers. */
  label: string
  /** Offsets from the figure's edges, as numbers (px) or CSS lengths. */
  dataPosition?: Partial<Record<'top' | 'right' | 'bottom' | 'left', number | string>>
  /** What to do or notice in the editor, at the foot of its overlay. */
  caption?: string
}

const { label, dataPosition, caption } = Astro.props
const code = dedent(Astro.props.code)
const dataSource = Astro.props.data === undefined ? undefined : dedent(Astro.props.data)
const expression = JSON5.parse(code)
const data = dataSource === undefined ? undefined : JSON5.parse(dataSource)

const isPlainObject = (value: unknown): value is Record<string, unknown> =>
  typeof value === 'object' && value !== null && !Array.isArray(value)

const shorthandKey = (value: Record<string, unknown>) => {
  const keys = Object.keys(value).filter((key) => key.startsWith('$'))
  return keys.length === 1 ? keys[0] : undefined
}

const evaluate = async (value: unknown) =>
  toJson5(await figTree.evaluate(value as never, data ? { data } : undefined))

const walk = async (value: unknown, name?: string): Promise<Item> => {
  if (isPlainObject(value)) {
    const key = shorthandKey(value)
    if (key !== undefined) {
      const payload = value[key]
      const children = Array.isArray(payload)
        ? await Promise.all(payload.map((child) => walk(child)))
        : isPlainObject(payload) && shorthandKey(payload) === undefined
          ? await Promise.all(Object.entries(payload).map(([param, child]) => walk(child, param)))
          : [await walk(payload)]
      return { kind: 'node', name, text: key, result: await evaluate(value), children }
    }
  }
  const text = toJson5(value)
  if (typeof value === 'string' && value.startsWith('$')) {
    const result = await evaluate(value)
    // A reference is shown bare: its colour marks it, and quotes would only
    // widen the tree
    if (result !== text) return { kind: 'reference', name, text: value, result, children: [] }
  }
  return { kind: 'leaf', name, text, children: [] }
}

const root = await walk(expression)

const placement =
  dataPosition &&
  Object.entries(dataPosition)
    .map(([side, offset]) => `${side}: ${typeof offset === 'number' ? `${offset}px` : offset}`)
    .join('; ')
---

<div class="fds-editable not-content">
  <figure class="fds-tree-figure">
    <div class="fds-tree" role="img" aria-label={label}>
      <div class="fds-tree-canvas">
        {
          data !== undefined && (
            <div
              class:list={['fds-tree-data', { 'fds-tree-data--placed': placement }]}
              style={placement}
            >
              <span class="fds-tree-data-label">Data</span>
              <code>{toJson5(data)}</code>
            </div>
          )
        }
        <ul>
          <TreeItem item={root} />
        </ul>
      </div>
    </div>
    <figcaption>
      <span>Evaluated by fig-tree-evaluator {figTree.version} when this page was built</span>
      <a class="fds-editor-link" href={playgroundHref({ expression: code, data: dataSource })}>
        Open in editor
      </a>
    </figcaption>
  </figure>
  <ExpressionEditor client:visible expression={code} data={dataSource} caption={caption} />
</div>

<script>
  import { layOutTrees } from '../lib/treeLayout'
  layOutTrees()
</script>
