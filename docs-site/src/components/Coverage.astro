---
/**
 * A `fallbackCoverage()` example: the expression, and the report the
 * analysis gives for it, computed when the site is built with the same
 * instance the static examples evaluate with (lib/figTree.ts). The report is
 * never typed by hand, so it can't drift from what the analysis says.
 *
 * The analysis needs no data, so an example has none, and no editor: the
 * site's editors don't show coverage.
 */
import { Code } from '@astrojs/starlight/components'
import JSON5 from 'json5'
import { fallbackCoverage } from 'fig-tree-evaluator/authoring'
import { exampleFigTree } from '../lib/figTree'
import { dedent } from '../lib/dedent'
import { toJson5 } from '../lib/json5'

interface Props {
  /** The expression, as JSON5 source. Comments are kept in the display. */
  code: string
  /** Analyse with the Custom operators pages' operators registered (lib/operators/). */
  customOperators?: boolean
  /** A label for the expression's code block. */
  title?: string
}

const { title = 'Expression', customOperators } = Astro.props
const figTree = exampleFigTree({ customOperators })
const code = dedent(Astro.props.code)

const where = `<Coverage> in ${Astro.url.pathname}:\n${code}`
let expression: unknown
try {
  expression = JSON5.parse(code)
} catch (error) {
  throw new Error(`${where}\n\nIts expression isn't valid JSON5: ${(error as Error).message}`)
}
const report = await fallbackCoverage(figTree, expression)
---

<div class="not-content">
  <figure class="fds-expression">
    <Code code={code} lang="json5" title={title} />
    <Code code={toJson5(report)} lang="json5" title="Report" />
    <figcaption>
      <span>Analysed by fig-tree-evaluator {figTree.version} when this page was built</span>
    </figcaption>
  </figure>
</div>
