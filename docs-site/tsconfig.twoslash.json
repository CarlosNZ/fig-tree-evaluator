{
  // The compiler options twoslash checks host-code snippets with: those of a
  // typical ESM consumer of the package
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // Every snippet is a module, so one with no imports can still use
    // top-level await
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": []
  }
}
