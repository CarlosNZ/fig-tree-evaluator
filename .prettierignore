# Mirrors the `ignores` list in eslint.config.mjs, plus the files that are
# generated or fetched rather than authored. Prettier already skips
# node_modules and .git by default.

# Build output
build

# Agent worktrees — each one a full checkout of this repo
.claude
.worktrees

# The frozen v2 engine and the v2 test material. v2-src is a record mined by
# the Phase-15 converter; test/V2 must stay byte-identical; test/v2-working
# holds v2-syntax migration source; test/__mocks__ is v2-only HTTP mock
# infrastructure used by `pnpm test:v2`.
v2-src
test/V2
test/v2-working
test/__mocks__

# Gitignored scratch space and the template it is copied from
src/dev/playground.ts
src/dev/playground_example.ts

# Generated: an 8 MB fixture emitted by codegen/generateMassiveQuery.ts
test/massiveQuery.json

# Fetched: published artifact pages downloaded verbatim by
# codegen/fetchArtifacts.mjs — they are copies of what is live, not source
docs-artifacts/*.html

# Real-world benchmark fixtures: the v2 corpus as exported from Conforma,
# kept byte-identical, and the v3 forms bench/real-world/migrate.ts emits
# from it
bench/real-world/*.json

# Generated: browser bundles of the benches
bench/browser/dist

# Lockfile
pnpm-lock.yaml
