    "ON_REVIEW_SUBMIT_sendNotification_5935": {
        "condition": {
            "children": [
                {
                    "children": [
                        "applicationData.outcome"
                    ],
                    "operator": "objectProperties"
                },
                "REJECTED"
            ],
            "operator": "="
        },
        "parameter_queries": {
            "email": {
                "fallback": "",
                "operator": "getData",
                "property": "applicationData.email"
            },
            "message": {
                "string": "{{applicationData.responses.orgData.data.name}}  \n{{applicationData.responses.orgData.data.address}}\n\nDear {{applicationData.firstName}} {{applicationData.lastName}},\n\nThe National Drugs and Medical Supplies Committee has considered your application for inclusion of **{{drugName}}** drug into the Tongan Registered Medicinal Drug list.\n\nWe refer to the details of the medicinal drug as follows:\n\nProprietary name (trade name): {{drugName}}  \nStrength(s) per dosage unit: {{strength}}\n \nEvaluation of the application has been completed. Pursuant to the Therapeutic Goods Act of 2020, Chapter 12.16 of the Laws of the Kingdom of Tonga, we regret to inform you that your application was unsuccessful and has been rejected. The following reasons are given by the Committee:\n\n{{reasons}}\n\nPlease address any future correspondence regarding the outcome of your application to the Registration Section of the Central Pharmacy and Medical Store.\n\nYours Sincerely,  \n\nNational Drugs and Medical Supplies Committee Chairperson.\nMinistry of Health (Potungaue ‘o e Mo’ui)\nNuku’alofa, Tonga \ntongadrugregulatory@gmail.com Date: {{date}}",
                "operator": "stringSubstitution",
                "substitutions": {
                    "date": {
                        "args": [
                            "dd LLLL, yyyy"
                        ],
                        "operator": "getFormattedDate"
                    },
                    "reasons": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.reviewData.latestDecision.comment"
                    },
                    "drugName": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.brandName.text"
                    },
                    "strength": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.Generics.list.additionalInfo.value.text",
                        "outputType": "string"
                    }
                }
            },
            "subject": {
                "string": "Tongan Registered List of Medicinal Drugs - %1",
                "operator": "stringSubstitution",
                "substitutions": [
                    {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.applicationSerial"
                    }
                ]
            }
        }
    },
    "ON_REVIEW_SUBMIT_sendNotification_5936": {
        "condition": {
            "fallback": null,
            "fragment": "Application Approved"
        },
        "parameter_queries": {
            "email": {
                "fallback": "",
                "operator": "getData",
                "property": "applicationData.email"
            },
            "message": {
                "string": "Dear {{applicationData.firstName}} {{applicationData.lastName}},\n\nThe National Drugs and Medical Supplies Committee has considered your application for inclusion of **{{drugName}}** drug into the Tongan Registered Medicinal Drug list.\n\nEvaluation of the application has been completed. We are pleased to inform you that your application was successful and an approval for registration under the Therapeutic Goods Act of 2020, Chapter 12.16 of the Laws of the Kingdom of Tonga is granted, subject to the conditions in this email and its attachments. This email and its attachments constitute the marketing authorization. The following special conditions of registration are listed by the Committee:\n\n1. The product(s) must conform with all the details provided in your application\n2. No changes may be made to the product without prior approval of the committee\n3. All advertising and promotion of the product(s) must be consistent with the agreed product information.\n\nPlease retain the certificate as proof of registration in the Kingdom Of Tonga. It can also be accessed on the Tongan Drug Regulatory Online Services Portal. \n\nMedicinal Drug registration Number: {{registrationId}}  \nProduct Name:  **{{drugName}}**  \nManufacturer: {{manufacturer}}      \nLegal Class: {{class}}  \nName of Market Authorisation Holder: {{marketAuthHolder}}\n\nPlease find attached your registration certificate with full product details.\n\nKind regards,\n\nNational Drugs and Medical Supplies Committee Chairperson\nMinistry of Health",
                "operator": "stringSubstitution",
                "substitutions": {
                    "class": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.legalClass.selection"
                    },
                    "drugName": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.brandName.text"
                    },
                    "manufacturer": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.manName.text"
                    },
                    "registrationId": {
                        "fallback": "*generated on approval*",
                        "operator": "getData",
                        "property": "outputCumulative.generatedText"
                    },
                    "marketAuthHolder": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.orgName"
                    }
                }
            },
            "subject": {
                "string": "Tongan Registered List of Medicinal Drugs - %1",
                "operator": "stringSubstitution",
                "substitutions": [
                    {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.applicationSerial"
                    }
                ]
            },
            "attachments": {
                "fallback": null,
                "operator": "getData",
                "property": "outputCumulative.document.uniqueId"
            }
        }
    },
