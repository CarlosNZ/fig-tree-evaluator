            "message": {
                "string": "{{applicationData.responses.orgData.data.name}}  \n{{applicationData.responses.orgData.data.address}}\n\nDear {{applicationData.firstName}} {{applicationData.lastName}},\n\nYour recent application ({{applicationData.applicationSerial}}) for registration of the medicinal drug **{{drugName}}**  was incomplete. \n\nThe details of the medicinal drug are as follows:\n\nProprietary name (trade name): {{drugName}}   \nStrength(s) per dosage unit: {{strength}}  \n \nEvaluation of the application is in process. The following items should be attended to before returning the application to the Registration Section of the Central Pharmacy and Medical Store:\n\n{{comments}}\n\nTo review the application requiring your attention and respond to the request, please visit:\n\n{{applicationData.environmentData.webHostUrl}}/application/{{applicationData.applicationSerial}}\n\nPlease provide a response to these questions within 10 days. Failure to respond within this timeframe may delay a decision on your application, or the National Drugs and Medical Supplies Committee may at its discretion proceed to decide without further responses from you.\n\nYours Sincerely,  \n \nNational Drugs and Medical Supplies Committee Chairperson.\nMinistry of Health (Potungaue ‘o e Mo’ui)  \nNuku’alofa, Tonga  \ntongadrugregulatory@gmail.com \n\nDate: {{date}}\n",
                "operator": "stringSubstitution",
                "substitutions": {
                    "date": {
                        "args": [
                            "dd LLLL, yyyy"
                        ],
                        "operator": "getFormattedDate"
                    },
                    "serial": null,
                    "comments": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.reviewData.latestDecision.comment"
                    },
                    "drugName": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.brandName.text"
                    },
                    "strength": {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.responses.Generics.list.additionalInfo.value.text",
                        "outputType": "string"
                    }
                }
            },
            "subject": {
                "string": "Tongan Registered List of Medicinal Drugs - %1",
                "operator": "stringSubstitution",
                "substitutions": [
                    {
                        "fallback": null,
                        "operator": "getData",
                        "property": "applicationData.applicationSerial"
                    }
                ]
            }
        }
    },
